@startuml componentes
' Diagrama de componentes del mensajero, con los archivos reales de la implementación
title Diagrama de componentes - Mensajero WebRTC
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontSize 12

package "Navegador (servidor/public)" {
  [index.html\nInterfaz web] as UI
  [app.js\nSeñalización (WebSocket),\nusuarios en línea y chat] as APP
  [webrtc.js\nConexión entre pares\n(RTCPeerConnection,\nperfect negotiation)] as RTC
  [llamada.js\nCaptura de medios (getUserMedia)\ny videollamada] as LLA
  [archivos.js\nArchivos por RTCDataChannel\n(16 KiB, SHA-256)] as ARC
}

package "Nodo (contenedor Docker, servidor/src)" {
  [servidor.js\nHTTP (estáticos, /salud, /usuarios)\ny WebSocket /ws y /nodo] as SRV
  [enlace.js\nEnlace saliente al nodo par] as ENL
  [directorio.js\nUsuarios locales y remotos] as DIR
  [registro.js\nLogs en stdout] as LOG
}

node "Nodo par\n(misma imagen)" as PAR

interface "HTTP GET" as I_HTTP
interface "WS /ws (JSON)" as I_WS
interface "WS /nodo (JSON)" as I_NODO
interface "SRTP / SCTP sobre UDP\n(hacia el otro navegador)" as I_P2P

SRV -- I_HTTP
SRV -- I_WS
SRV -- I_NODO
RTC -- I_P2P

UI ..> I_HTTP : carga la página y los scripts
UI ..> APP
APP ..> I_WS : registro, mensaje, llamada, oferta,\nrespuesta, candidato, colgar
RTC ..> APP : App.enviar / App.on
LLA ..> RTC : addTrack / removeTrack
ARC ..> RTC : createDataChannel
LLA ..> APP : avisos y chat
ARC ..> APP : archivos en el chat

SRV ..> DIR : ¿usuario local o remoto?
SRV ..> ENL : reenviar al otro nodo
ENL ..> PAR : ws://nodo-par:8080/nodo
PAR ..> I_NODO
SRV ..> LOG
ENL ..> LOG
@enduml
